# RetailOS Authentication Configuration
# See GOOGLE_OAUTH_SETUP.md for complete setup guide

# =============================================================================
# LOCAL USER AUTHENTICATION (Always available as fallback)
# =============================================================================

# Option 1: Old style (backward compatible)
# [auth]
# username = "admin"
# password = "ChangeMeNow123"

# Option 2: New style with multiple users (RECOMMENDED)
[[access.users]]
username = "admin"
name = "Retail Admin"
role = "admin"
password = "ChangeMeNow123"
# Or use password hash instead:
# password_hash = "pbkdf2_sha256$390000$your-salt$your-base64-hash"

[[access.users]]
username = "analyst"
name = "Operations Analyst"
role = "analyst"
password = "Analyse123"

[[access.users]]
username = "viewer"
name = "Business Viewer"
role = "viewer"
password = "Viewer123"

# =============================================================================
# GOOGLE OAUTH 2.0 CONFIGURATION (Optional - enables "Sign in with Google")
# =============================================================================

[auth]
# Redirect URI for OAuth callback
redirect_uri = "http://localhost:8501/oauth2callback"
# Cookie secret for session management (generate: python -c 'import secrets; print(secrets.token_hex(32))')
cookie_secret = "replace-with-a-random-32-character-string"

# Google OAuth credentials (from Google Cloud Console)
[auth.google]
client_id = "your-google-client-id.apps.googleusercontent.com"
client_secret = "your-google-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# =============================================================================
# GOOGLE USER ROLE MAPPING
# =============================================================================
# Map Google email addresses to RetailOS roles

[access.google_roles]
admin = ["admin@example.com", "ceo@company.com"]
analyst = ["analyst@example.com", "operationsmanager@company.com"]
viewer = ["viewer@example.com", "stakeholder@company.com"]

# =============================================================================
# ENVIRONMENT VARIABLE OVERRIDE (For production deployments)
# =============================================================================
# These environment variables take precedence over the above:
#
# Local user:
#   - RETAILOS_AUTH_USERNAME
#   - RETAILOS_AUTH_PASSWORD or RETAILOS_AUTH_PASSWORD_HASH
#   - RETAILOS_AUTH_NAME
#   - RETAILOS_AUTH_ROLE
#
# Google OAuth:
#   - RETAILOS_AUTH_REDIRECT_URI
#   - RETAILOS_AUTH_COOKIE_SECRET
#   - RETAILOS_AUTH_GOOGLE_CLIENT_ID
#   - RETAILOS_AUTH_GOOGLE_CLIENT_SECRET
#   - RETAILOS_AUTH_GOOGLE_METADATA_URL
#
# Google role mappings:
#   - RETAILOS_GOOGLE_ADMIN_EMAILS="admin@company.com,ceo@company.com"
#   - RETAILOS_GOOGLE_ANALYST_EMAILS="analyst@company.com"
#   - RETAILOS_GOOGLE_VIEWER_EMAILS="viewer@company.com,guest@company.com"
